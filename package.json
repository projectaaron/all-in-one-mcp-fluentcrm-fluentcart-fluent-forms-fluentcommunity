{
  "name": "fluentmcp",
  "version": "0.7.1",
  "description": "MCP server giving AI harnesses full CRUD control of WPManageNinja Fluent products (FluentCRM, FluentCart) on a WordPress site",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fluentmcp": "dist/index.js",
    "fluentmcp-remote": "dist/remote.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "gen:docs": "node scripts/gen-api-docs.mjs",
    "gen:maps": "node scripts/gen-endpoint-maps.mjs",
    "gen:catalog": "node scripts/gen-tool-catalog.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "pack:extension": "npm run build && npm prune --omit=dev && npx --yes @anthropic-ai/mcpb pack . fluentmcp.mcpb && npm ci",
    "start:remote": "node dist/remote.js",
    "deploy:cloudflare": "wrangler deploy",
    "dev:cloudflare": "wrangler dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
