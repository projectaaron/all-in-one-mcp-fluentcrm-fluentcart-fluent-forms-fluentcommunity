# fluentMCP configuration — copy to .env (or set as real environment variables
# in your MCP client config) and fill in your values.
#
# A product is ENABLED when its username + password are both set. Products
# without credentials are skipped cleanly and reported by verify_setup as
# "not configured".

# Your WordPress site root (no trailing slash needed). Required.
FLUENT_SITE_URL=https://example.com

# --- FluentCRM ---------------------------------------------------------------
# Create under: FluentCRM -> Settings -> Rest API -> "Create New API Key".
# Use a dedicated FluentCRM Manager account (not an Administrator).
FLUENTCRM_API_USERNAME=
FLUENTCRM_API_PASSWORD=

# --- FluentCart --------------------------------------------------------------
# A WordPress user with FluentCart admin capabilities + an Application Password
# created under: WP Admin -> Users -> Profile -> Application Passwords.
FLUENTCART_API_USERNAME=
FLUENTCART_API_PASSWORD=

# --- Optional tuning ----------------------------------------------------------
# HTTP timeout per request, in milliseconds (default 30000)
#FLUENT_HTTP_TIMEOUT_MS=30000
# Max retries for retryable failures (default 3)
#FLUENT_HTTP_MAX_RETRIES=3
