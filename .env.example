# fluentMCP configuration — copy to .env (or set as real environment variables
# in your MCP client config) and fill in your values.
#
# ONE WordPress Application Password runs the whole server (FluentCRM,
# FluentCart, WP Social Ninja, Fluent Forms and FluentCommunity all
# authenticate against WordPress core).
# Create it under:
#   WP Admin -> Users -> your user -> Application Passwords -> Add New
# The user needs admin capabilities for the products you want enabled.

# Your WordPress site root (no trailing slash needed). Required.
FLUENT_SITE_URL=https://example.com

FLUENT_API_USERNAME=
FLUENT_API_PASSWORD=

# --- Optional per-product overrides -------------------------------------------
# Only needed if you want a DIFFERENT user per product (e.g. a scoped FluentCRM
# manager account). When set, these win over FLUENT_API_* for that product.
#FLUENTCRM_API_USERNAME=
#FLUENTCRM_API_PASSWORD=
#FLUENTCART_API_USERNAME=
#FLUENTCART_API_PASSWORD=
#WPSOCIALNINJA_API_USERNAME=
#WPSOCIALNINJA_API_PASSWORD=
#FLUENTFORMS_API_USERNAME=
#FLUENTFORMS_API_PASSWORD=
#FLUENTCOMMUNITY_API_USERNAME=
#FLUENTCOMMUNITY_API_PASSWORD=

# --- Remote mode only (npm run start:remote — see docs/REMOTE.md) -------------
# Required shared secret for the HTTP endpoint; 16+ chars. Generate with:
#   openssl rand -hex 32
#FLUENT_MCP_TOKEN=
# Listen port / bind address (defaults: 3000 / 0.0.0.0)
#PORT=3000
#FLUENT_MCP_HOST=0.0.0.0

# --- Optional tuning ----------------------------------------------------------
# HTTP timeout per request, in milliseconds (default 30000)
#FLUENT_HTTP_TIMEOUT_MS=30000
# Max retries for retryable failures (default 3; 0 disables retries)
#FLUENT_HTTP_MAX_RETRIES=3
# Tool surface (default: individual — one tool per operation, ~700 small
# tools plus the tool_map index). Set to "grouped" for the legacy surface
# (~46 tools, one per area, an `action` parameter selects the operation) if
# your MCP client struggles with large tool lists.
#FLUENT_TOOL_MODE=individual
# Admin-locked tools: these refuse unconditionally — confirm:true cannot
# override. Default locks the no-agent-use catastrophes (full CRM wipe,
# audience-wide contact delete, API-key revocation, the test delete
# resolver, payment-method disconnect, license-key regeneration).
# A comma list of individual tool names REPLACES the default; the token
# "default" expands to it; the single value "none" disables locking.
#FLUENT_LOCKED_TOOLS=default
#FLUENT_LOCKED_TOOLS=default,crm_contacts_bulk_action
#FLUENT_LOCKED_TOOLS=none
