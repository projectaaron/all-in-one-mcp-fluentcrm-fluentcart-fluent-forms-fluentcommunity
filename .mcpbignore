# Ship only what the extension needs at runtime:
# manifest.json, dist/, production node_modules/, package.json, README, LICENSE.
.git
.github
.claude
src
tests
docs
scripts
evals
snippets
.env
.env.example
.gitattributes
.gitignore
.mcpbignore
tsconfig.json
vitest.config.ts
package-lock.json
CHANGELOG.md
*.mcpb
Dockerfile
# Not needed by the extension: the vitest cache, the download readme
# template (unrendered {{VERSION}}), the Cloudflare Worker build and config,
# contributor docs, the SVG source of the icon, and release/deploy leftovers.
node_modules/.vite
node_modules/.cache
packaging
wrangler.jsonc
dist/worker.js
dist/worker.d.ts
CONTRIBUTING.md
icon.svg
.wrangler
.dev.vars
all-in-one-mcp-for-fluent-suite*
fluentmcp-*-source.zip
